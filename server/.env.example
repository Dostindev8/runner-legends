# Runner Legends — progression server. Copy to .env (never commit real secrets).
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/runner_legends

# --- JWT ---
# Default (existing builds): HS256 symmetric secret.
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional RS256 path (mega prompt v3.0): when BOTH keys are set, AuthModule uses
# RS256 instead of HS256. Paste PEMs as single lines with \n for newlines.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Client note (future EXTEND): prefer HttpOnly + Secure + SameSite cookies for
# access tokens — never store JWTs in localStorage. API still returns Bearer
# tokens in JSON today for backward-compatible clients. See docs/JWT_RS256.md.

# Comma-separated allowed origins for CORS (client + admin tools)
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the app (1 behind a single LB). GDD/prompt §2.
TRUST_PROXY_HOPS=1
