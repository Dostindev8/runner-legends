# Runner Legends — tournament service. Copy to .env.
PORT=3100
NODE_ENV=development
# If REDIS_URL is unset the service falls back to an in-memory store (dev only,
# per the infra rule "Redis with fallback to Map()").
REDIS_URL=
# PostgreSQL for replay metadata (production). Empty => in-memory repo (dev).
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1
# Rate limit: max score submissions per hour per player (GDD 3.5).
MAX_SUBMISSIONS_PER_HOUR=20
